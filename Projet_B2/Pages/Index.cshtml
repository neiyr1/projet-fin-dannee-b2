@page
@* FONCTIONNALITE: page d'accueil apres connexion et raccourcis vers les parcours principaux. *@
@{ Layout = "_Layout"; ViewData["Title"] = "Home"; }

<section class="hero">
  <div class="row align-items-center">
    <div class="col-lg-8">
      <div class="badge bg-light text-primary mb-3 px-3 py-2" style="border-radius:999px">
        <i class="bi bi-stars me-1"></i> Plateforme coworking intelligente
      </div>
      <h1 class="mb-2">Réserver, suivre et administrer<br/>les espaces en un seul endroit.</h1>
      <p class="lead mb-4">Consultez les disponibilités, réservez un poste ou une salle, puis retrouvez vos factures et vos accès depuis votre espace.</p>
      <div class="hero-cta d-flex flex-wrap gap-2">
        <a href="/Booking" class="btn btn-light fw-semibold"><i class="bi bi-calendar-plus me-2"></i>Réserver</a>
        <a href="/SpacesMap" class="btn btn-outline-light"><i class="bi bi-map me-2"></i>Voir le plan</a>
      </div>
    </div>
    <div class="col-lg-4 d-none d-lg-block text-center">
      <img src="~/images/Logo_1_mini.svg" asp-append-version="true" alt="Logo" style="height:120px;filter:drop-shadow(0 10px 30px rgba(0,0,0,0.3))" />
    </div>
  </div>
  <div class="hero-illustration"></div>
</section>

<div class="row g-3 mb-4" id="statsRow">
  <div class="col-6 col-md-3">
    <div class="card stat-card">
      <div class="card-body text-center">
        <i class="bi bi-grid fs-2 text-primary"></i>
        <div class="fs-3 fw-bold mt-1" id="statSpaces">--</div>
        <div class="text-muted small">Espaces</div>
      </div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="card stat-card">
      <div class="card-body text-center">
        <i class="bi bi-calendar-check fs-2 text-warning"></i>
        <div class="fs-3 fw-bold mt-1" id="statReservations">--</div>
        <div class="text-muted small">Réservations</div>
      </div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="card stat-card">
      <div class="card-body text-center">
        <i class="bi bi-people fs-2 text-info"></i>
        <div class="fs-3 fw-bold mt-1" id="statUsers">--</div>
        <div class="text-muted small">Utilisateurs</div>
      </div>
    </div>
  </div>
</div>

<h5 class="text-muted text-uppercase fw-bold small mb-2" style="letter-spacing:.05em">Actions rapides</h5>
<div class="row g-3">
  <div class="col-md-3">
    <a href="/Spaces" class="card action-card text-decoration-none text-dark h-100">
      <div class="card-body">
        <h5 class="card-title"><i class="bi bi-grid me-2 text-primary"></i>Espaces</h5>
        <p class="card-text text-muted small mb-0">Consulter et gérer les espaces disponibles.</p>
      </div>
    </a>
  </div>
  <div class="col-md-3">
    <a href="/Booking" class="card action-card text-decoration-none text-dark h-100">
      <div class="card-body">
        <h5 class="card-title"><i class="bi bi-calendar-check me-2 text-warning"></i>Réserver</h5>
        <p class="card-text text-muted small mb-0">Vérifier les disponibilités et réserver un créneau.</p>
      </div>
    </a>
  </div>
  <div class="col-md-3">
    <a href="/MyReservations" class="card action-card text-decoration-none text-dark h-100">
      <div class="card-body">
        <h5 class="card-title"><i class="bi bi-bookmark-check me-2 text-info"></i>Mes réservations</h5>
        <p class="card-text text-muted small mb-0">Suivre, modifier ou annuler vos réservations.</p>
      </div>
    </a>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', async () => {
    try {
      const res = await fetch('/api/stats', { credentials: 'include' });
      if (!res.ok) return;
      const data = await res.json();
      document.getElementById('statSpaces').textContent = data.spaces;
      document.getElementById('statReservations').textContent = data.reservations;
      document.getElementById('statUsers').textContent = data.users;
    } catch {}
  });
</script>
