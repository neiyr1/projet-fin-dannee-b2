@page
@{ Layout = "_Layout"; ViewData["Title"] = "Salles"; }

<div class="page-heading">
  <div>
    <h1 class="h4 mb-0"><i class="bi bi-door-open me-2 text-success"></i>Salles</h1>
    <div class="text-muted small">Gestion rapide des salles physiques affichees sur le plan.</div>
  </div>
  <a class="btn btn-outline-secondary btn-sm" href="/SpacesMap"><i class="bi bi-map me-1"></i>Voir le plan</a>
</div>

<div class="card mb-4">
  <div class="card-body">
    <form id="addRoomForm" class="row g-2 align-items-end">
      <div class="col-sm">
        <label class="form-label small text-muted">Nom</label>
        <input name="name" placeholder="e.g. Zeta" required class="form-control" />
      </div>
      <div class="col-auto">
        <label class="form-label small text-muted">Capacite</label>
        <input name="capacity" type="number" min="1" placeholder="6" required class="form-control" style="width:100px" />
      </div>
      <div class="col-auto">
        <label class="form-label small text-muted">Emplacement</label>
        <input name="location" placeholder="Etage 2" class="form-control" style="width:140px" />
      </div>
      <div class="col-auto">
        <button type="submit" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Ajouter</button>
      </div>
    </form>
  </div>
</div>

<div id="roomsList" class="row g-3"></div>
<div id="emptyState" class="text-center text-muted py-5" style="display:none">
  <i class="bi bi-inbox fs-1"></i>
  <p class="mt-2">Aucune salle pour le moment.</p>
</div>

<script src="/js/rooms.js" defer></script>
