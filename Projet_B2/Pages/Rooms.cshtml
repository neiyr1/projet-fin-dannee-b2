@page
@{ Layout = "_Layout"; ViewData["Title"] = "Rooms"; }

<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h4 mb-0"><i class="bi bi-door-open me-2 text-success"></i>Rooms</h1>
  <a class="btn btn-outline-secondary btn-sm" href="/SpacesMap"><i class="bi bi-map me-1"></i>View map</a>
</div>

<div class="card mb-4">
  <div class="card-body">
    <form id="addRoomForm" class="row g-2 align-items-end">
      <div class="col-sm">
        <label class="form-label small text-muted">Name</label>
        <input name="name" placeholder="e.g. Zeta" required class="form-control" />
      </div>
      <div class="col-auto">
        <label class="form-label small text-muted">Capacity</label>
        <input name="capacity" type="number" min="1" placeholder="6" required class="form-control" style="width:100px" />
      </div>
      <div class="col-auto">
        <label class="form-label small text-muted">Location</label>
        <input name="location" placeholder="Floor 2" class="form-control" style="width:140px" />
      </div>
      <div class="col-auto">
        <button type="submit" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Add Room</button>
      </div>
    </form>
  </div>
</div>

<div id="roomsList" class="row g-3"></div>
<div id="emptyState" class="text-center text-muted py-5" style="display:none">
  <i class="bi bi-inbox fs-1"></i>
  <p class="mt-2">No rooms yet. Add one above.</p>
</div>

<script src="/js/rooms.js" defer></script>
