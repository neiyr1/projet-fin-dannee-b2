@page
@* FONCTIONNALITE: page utilisateur pour consulter, modifier, annuler et telecharger ses reservations/factures. *@
@{ Layout = "_Layout"; ViewData["Title"] = "Mes réservations"; }

<div class="page-heading">
  <div>
    <h1 class="h4 mb-0"><i class="bi bi-calendar-check me-2 text-warning"></i>Mes réservations</h1>
    <div class="text-muted small">Suivi, facture, QR code, modification et annulation.</div>
  </div>
  <a class="btn btn-primary btn-sm" href="/Booking"><i class="bi bi-plus-lg me-1"></i>Nouvelle réservation</a>
</div>

<div id="resList" class="row g-3"></div>
<div id="emptyState" class="text-center text-muted py-5" style="display:none">
  <i class="bi bi-inbox fs-1"></i>
  <p class="mt-2">Vous n'avez pas encore de réservation.</p>
  <a class="btn btn-primary" href="/Booking">Réserver</a>
</div>

<!-- QR modal -->
<div class="modal fade" id="qrModal" tabindex="-1">
  <div class="modal-dialog modal-sm">
    <div class="modal-content">
      <div class="modal-header"><h5 class="modal-title">Votre QR code d'accès</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
      <div class="modal-body text-center">
        <img id="qrImg" alt="QR code" style="max-width:100%;border:1px solid #eee;border-radius:8px" />
        <div class="small text-muted mt-2" id="qrCaption"></div>
      </div>
    </div>
  </div>
</div>

<!-- Modify modal -->
<div class="modal fade" id="modModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <form id="modForm">
        <div class="modal-header"><h5 class="modal-title"><i class="bi bi-pencil me-2"></i>Modifier la réservation</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
        <div class="modal-body">
          <div class="mb-3"><label class="form-label">Date</label><input type="date" name="date" class="form-control" required /></div>
          <div class="row g-2">
            <div class="col"><label class="form-label">Heure de début</label><input type="number" name="startHour" min="7" max="21" class="form-control" required /></div>
            <div class="col"><label class="form-label">Durée</label><input type="number" name="hours" min="1" max="12" class="form-control" required /></div>
          </div>
          <input type="hidden" name="id" />
          <div id="modMsg" class="text-danger small mt-2"></div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Annuler</button>
          <button type="submit" class="btn btn-primary">Enregistrer</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
(async function(){
  const list = document.getElementById('resList');
  const empty = document.getElementById('emptyState');
  const esc = s => (s ?? '').toString().replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));

  function typeBadge(t){
    const map = { Nomad: 'bg-info', Office: 'bg-primary', Meeting: 'bg-warning text-dark', Conference: 'bg-danger' };
    return t ? `<span class="badge ${map[t] || 'bg-secondary'} me-1">${t}</span>` : '';
  }

  async function load(){
    const res = await fetch('/api/reservations/mine', { credentials: 'include' });
    if (res.status === 401) { location.href = '/Login'; return; }
    const items = await res.json();
    list.innerHTML = '';
    empty.style.display = items.length ? 'none' : '';
    for (const r of items){
      const statusBadge = r.status === 'Cancelled'
        ? '<span class="badge status-soft-muted"><i class="bi bi-x-circle me-1"></i>Annulée</span>'
        : '<span class="badge status-soft-success"><i class="bi bi-check-circle me-1"></i>Confirmée</span>';
      const invoice = r.invoiceNumber
        ? `<a class="btn btn-sm btn-outline-primary" href="/api/invoices/${r.id}" target="_blank"><i class="bi bi-file-earmark-pdf me-1"></i>${esc(r.invoiceNumber)}</a>`
        : '<span class="text-muted small">Pas de facture</span>';
      const isActive = r.status !== 'Cancelled';
      const qrBtn = isActive ? `<button class="btn btn-sm btn-outline-dark qr-btn" data-id="${r.id}" data-label="${esc(r.spaceName)}" title="Afficher le QR code" aria-label="Afficher le QR code pour ${esc(r.spaceName)}"><i class="bi bi-qr-code"></i></button>` : '';
      const modBtn = isActive ? `<button class="btn btn-sm btn-outline-secondary mod-btn" data-id="${r.id}" data-date="${esc(r.date)}" data-start="${r.startHour}" data-hours="${r.hours}" title="Modifier" aria-label="Modifier la réservation ${esc(r.spaceName)}"><i class="bi bi-pencil"></i></button>` : '';
      const cancelBtn = isActive ? `<button class="btn btn-sm btn-outline-danger del-btn" data-id="${r.id}" title="Annuler" aria-label="Annuler la réservation ${esc(r.spaceName)}"><i class="bi bi-x-circle"></i></button>` : '';
      const attLine = r.attendees ? `<div class="small text-muted"><i class="bi bi-people me-1"></i>${esc(r.attendees)}</div>` : '';

      const col = document.createElement('div');
      col.className = 'col-md-6';
      col.innerHTML = `
        <div class="card reservation-card h-100">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-start">
              <div>
                <h5 class="card-title mb-1">${typeBadge(r.spaceType)}${esc(r.spaceName) || 'Espace #' + r.id}</h5>
            <div class="text-muted small"><i class="bi bi-clock me-1"></i>${esc(r.date)} - ${String(r.startHour).padStart(2,'0')}:00 à ${String(r.startHour + r.hours).padStart(2,'0')}:00 (${r.hours}h)</div>
                ${attLine}
              </div>
              ${statusBadge}
            </div>
            <hr class="my-2" />
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
              <div>
                <div class="small text-muted">Total TTC</div>
            <div class="fw-bold">${(r.totalTTC || 0).toLocaleString('fr-FR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} €</div>
              </div>
              <div class="d-flex gap-2 flex-wrap justify-content-end reservation-actions">${invoice}${qrBtn}${modBtn}${cancelBtn}</div>
            </div>
          </div>
        </div>`;
      list.appendChild(col);

      const del = col.querySelector('.del-btn');
      if (del) del.addEventListener('click', async () => {
        if (!confirm('Annuler cette réservation ?')) return;
        const d = await fetch(`/api/reservations/${r.id}`, { method: 'DELETE', credentials: 'include' });
        if (d.ok) load(); else alert('Annulation impossible');
      });
      const qr = col.querySelector('.qr-btn');
      if (qr) qr.addEventListener('click', () => {
        document.getElementById('qrImg').src = `/api/reservations/${r.id}/qr?ts=${Date.now()}`;
      document.getElementById('qrCaption').textContent = `${r.spaceName} - ${r.date} ${String(r.startHour).padStart(2,'0')}:00`;
        new bootstrap.Modal(document.getElementById('qrModal')).show();
      });
      const mod = col.querySelector('.mod-btn');
      if (mod) mod.addEventListener('click', () => {
        const form = document.getElementById('modForm');
        form.elements['id'].value = r.id;
        form.elements['date'].value = r.date;
        form.elements['startHour'].value = r.startHour;
        form.elements['hours'].value = r.hours;
        document.getElementById('modMsg').textContent = '';
        new bootstrap.Modal(document.getElementById('modModal')).show();
      });
    }
  }

  document.getElementById('modForm').addEventListener('submit', async e => {
    e.preventDefault();
    const fd = new FormData(e.target);
    const id = fd.get('id');
    const payload = { date: fd.get('date'), startHour: parseInt(fd.get('startHour'), 10), hours: parseInt(fd.get('hours'), 10) };
    const res = await fetch(`/api/reservations/${id}`, { method: 'PUT', headers: {'Content-Type':'application/json'}, credentials: 'include', body: JSON.stringify(payload) });
    if (res.ok){
      bootstrap.Modal.getInstance(document.getElementById('modModal'))?.hide();
      load();
    } else {
      const j = await res.json().catch(()=>null);
      document.getElementById('modMsg').textContent = j?.error || 'Modification impossible';
    }
  });

  load();
})();
</script>
