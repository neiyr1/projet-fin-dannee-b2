@page
@{ Layout = "_Layout"; ViewData["Title"] = "Utilisateurs"; }
<div class="d-flex justify-content-between align-items-center mb-3">
  <div class="d-flex align-items-center gap-3">
    <img src="~/images/Logo_1_mini.svg" asp-append-version="true" alt="Logo" style="height:36px" />
    <h1 class="h4 mb-0">Gestion des utilisateurs</h1>
  </div>
</div>

<div class="card mb-4">
  <div class="card-header fw-semibold">Ajouter un utilisateur</div>
  <div class="card-body">
    <form id="addUserForm" class="row g-2 align-items-end">
      <div class="col-sm">
        <label class="form-label small">Prénom</label>
        <input name="name" placeholder="Prénom" class="form-control" />
      </div>
      <div class="col-sm">
        <label class="form-label small">Nom</label>
        <input name="lastName" placeholder="Nom" class="form-control" />
      </div>
      <div class="col-sm">
        <label class="form-label small">Email *</label>
        <input name="email" type="email" placeholder="Email" required class="form-control" />
      </div>
      <div class="col-sm">
        <label class="form-label small">Mot de passe *</label>
        <input name="password" type="password" placeholder="Mot de passe" required class="form-control" />
      </div>
      <div class="col-auto">
        <label class="form-label small">Rôle</label>
        <select name="role" class="form-select">
          <option value="User">Utilisateur</option>
          <option value="Admin">Admin</option>
        </select>
      </div>
      <div class="col-auto">
        <button type="submit" class="btn btn-primary">Ajouter</button>
      </div>
      <div class="col-12"><div id="addMsg" class="small text-muted"></div></div>
    </form>
  </div>
</div>

<div class="card">
  <div class="card-header fw-semibold">Liste des utilisateurs</div>
  <div class="card-body p-0">
    <table class="table table-hover mb-0">
      <thead class="table-light">
        <tr><th>ID</th><th>Prénom</th><th>Nom</th><th>Email</th><th>Rôle</th><th></th></tr>
      </thead>
      <tbody id="usersList"></tbody>
    </table>
  </div>
</div>

<script src="/js/users.js" defer></script>
