@page
@{ Layout = "_Layout"; ViewData["Title"] = "Utilisateurs"; }

<div class="page-heading">
  <div>
    <h1 class="h4 mb-0"><i class="bi bi-people me-2 text-info"></i>Gestion des utilisateurs</h1>
    <div class="text-muted small">Rôles, accès, vérification et réservations associées.</div>
  </div>
  <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#newUserModal">
    <i class="bi bi-person-plus me-1"></i>Nouvel utilisateur
  </button>
</div>

<div class="card">
  <div class="card-body p-3 pb-0">
    <div class="input-group input-group-sm" style="max-width:380px">
      <span class="input-group-text"><i class="bi bi-search"></i></span>
      <input id="userSearch" type="search" class="form-control" placeholder="Filtrer par nom, email ou rôle..." />
    </div>
  </div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>#</th><th>Nom</th><th>Email</th><th>Rôle</th><th>AD</th><th>État</th><th>Vérifié</th><th>Réservations</th><th class="text-end pe-3">Actions</th>
          </tr>
        </thead>
        <tbody id="usersBody">
          <tr><td colspan="9" class="text-center text-muted py-4">Chargement...</td></tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- New user modal -->
<div class="modal fade" id="newUserModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <form id="newUserForm">
        <div class="modal-header">
          <h5 class="modal-title"><i class="bi bi-person-plus me-2 text-primary"></i>Créer un utilisateur</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">Nom</label>
            <input name="name" class="form-control" required />
          </div>
          <div class="mb-3">
            <label class="form-label">Email</label>
            <input name="email" type="email" class="form-control" required />
          </div>
          <div class="mb-3">
            <label class="form-label">Rôle</label>
            <select name="role" class="form-select">
              <option value="User">User</option>
              <option value="Member">Member</option>
              <option value="Accueil">Accueil</option>
              <option value="Comptabilite">Comptabilite</option>
              <option value="Admin">Admin</option>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label">Mot de passe initial</label>
            <input name="password" class="form-control" minlength="6" placeholder="changeme123" />
            <div class="form-text">Utilisé pour le compte AD si l'Active Directory est activé. Laisser vide pour <code>changeme123</code>.</div>
          </div>
          <div id="newUserMsg" class="text-danger small"></div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Annuler</button>
          <button type="submit" class="btn btn-primary">Créer</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Reset password modal -->
<div class="modal fade" id="resetPwdModal" tabindex="-1">
  <div class="modal-dialog modal-sm">
    <div class="modal-content">
      <form id="resetPwdForm">
        <div class="modal-header">
          <h5 class="modal-title"><i class="bi bi-key me-2 text-warning"></i>Réinitialiser le mot de passe</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="mb-2 small text-muted">Utilisateur <strong id="resetPwdLabel"></strong></div>
          <input name="password" type="text" class="form-control" minlength="6" required placeholder="Nouveau mot de passe" />
          <input type="hidden" name="id" />
          <div id="resetPwdMsg" class="text-danger small mt-2"></div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Annuler</button>
          <button type="submit" class="btn btn-warning">Réinitialiser</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
(function(){
  const tbody = document.getElementById('usersBody');
  const searchInput = document.getElementById('userSearch');
  let allUsers = [];
  const roleBadge = role => {
    const map = { Admin: 'bg-danger', Comptabilite: 'bg-info text-dark', Accueil: 'bg-warning text-dark', Member: 'bg-primary', User: 'bg-secondary' };
    const labels = { Comptabilite: 'Comptabilité', Accueil: 'Accueil', Member: 'Membre', User: 'Utilisateur', Admin: 'Admin' };
    return `<span class="badge ${map[role] || 'bg-secondary'}">${labels[role] || role || '-'}</span>`;
  };
  const esc = s => (s ?? '').toString().replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));

  function render(items){
    if (!items.length) { tbody.innerHTML = '<tr><td colspan="9" class="text-center text-muted py-4">Aucun utilisateur.</td></tr>'; return; }
    tbody.innerHTML = '';
    for (const u of items){
      const tr = document.createElement('tr');
      const verifiedCell = u.emailVerified
        ? `<span class="badge status-soft-success"><i class="bi bi-check-circle me-1"></i>Vérifié</span>`
        : `<span class="badge status-pending"><i class="bi bi-clock-history me-1"></i>En attente</span>
           <button class="btn btn-sm btn-outline-success ms-1 verify-btn" data-id="${u.id}" title="Marquer comme verifie"><i class="bi bi-check2"></i></button>`;
      const adCell = u.adSamAccountName
        ? `<span class="badge bg-primary-subtle text-primary border">AD</span><div class="small text-muted">${esc(u.adSamAccountName)}</div><div class="small text-muted">${esc(u.adUserPrincipalName)}</div>`
        : `<span class="badge bg-light text-dark border">Local</span>`;
      const isActive = u.accountEnabled !== false;
      const statusCell = isActive
        ? `<span class="badge status-soft-success"><i class="bi bi-person-check me-1"></i>Actif</span>`
        : `<span class="badge status-soft-muted"><i class="bi bi-person-slash me-1"></i>Inactif</span>`;
      if (!isActive) tr.classList.add('table-secondary');
      tr.innerHTML = `
        <td class="text-muted">#${u.id}</td>
        <td><input class="form-control form-control-sm inline-edit" data-id="${u.id}" data-field="name" value="${esc(u.name)}" /></td>
        <td><input class="form-control form-control-sm inline-edit" data-id="${u.id}" data-field="email" type="email" value="${esc(u.email)}" /></td>
        <td>
          <select class="form-select form-select-sm role-select" data-id="${u.id}" style="width:auto;display:inline-block">
            ${[
              ['User','Utilisateur'],
              ['Member','Membre'],
              ['Accueil','Accueil'],
              ['Comptabilite','Comptabilité'],
              ['Admin','Admin']
            ].map(([value, label]) => `<option value="${value}" ${u.role===value?'selected':''}>${label}</option>`).join('')}
          </select>
          <span class="ms-2">${roleBadge(u.role)}</span>
        </td>
        <td>${adCell}</td>
        <td>${statusCell}</td>
        <td>${verifiedCell}</td>
        <td><span class="badge bg-light text-dark border">${u.bookings}</span></td>
        <td class="text-end pe-3 text-nowrap table-actions">
          <button class="btn btn-sm ${isActive ? 'btn-outline-secondary' : 'btn-outline-success'} status-btn" data-id="${u.id}" data-enabled="${isActive ? 'false' : 'true'}" data-label="${esc(u.name || u.email)}" title="${isActive ? 'Desactiver le compte' : 'Reactiver le compte'}"><i class="bi ${isActive ? 'bi-person-slash' : 'bi-person-check'}"></i></button>
          <button class="btn btn-sm btn-outline-warning reset-btn" data-id="${u.id}" data-label="${esc(u.name || u.email)}" title="Réinitialiser le mot de passe"><i class="bi bi-key"></i></button>
          <button class="btn btn-sm btn-outline-danger del-btn" data-id="${u.id}" data-label="${esc(u.name || u.email)}" title="Supprimer l'utilisateur"><i class="bi bi-trash"></i></button>
        </td>`;
      tbody.appendChild(tr);
    }
    bindRowHandlers();
  }

  function applyFilter(){
    const q = (searchInput.value || '').trim().toLowerCase();
    if (!q) { render(allUsers); return; }
    const filtered = allUsers.filter(u =>
      (u.name || '').toLowerCase().includes(q) ||
      (u.email || '').toLowerCase().includes(q) ||
      (u.role || '').toLowerCase().includes(q));
    render(filtered);
  }

  async function load(){
    try {
      const res = await fetch('/api/users', { credentials: 'include' });
      if (res.status === 401) { location.href = '/Login'; return; }
      if (res.status === 403) {
        tbody.innerHTML = '<tr><td colspan="9" class="text-center text-danger py-4">Rôle admin requis.</td></tr>';
        return;
      }
      if (!res.ok) {
        const text = await res.text();
        console.error('GET /api/users failed', res.status, text);
        tbody.innerHTML = `<tr><td colspan="9" class="text-center text-danger py-4">Erreur API ${res.status}. Consultez la console navigateur et le log dotnet.</td></tr>`;
        return;
      }
      allUsers = await res.json();
      applyFilter();
    } catch (err) {
      console.error('Load users threw', err);
      tbody.innerHTML = `<tr><td colspan="9" class="text-center text-danger py-4">${err.message || 'Erreur réseau'}</td></tr>`;
    }
  }

  function bindRowHandlers(){
    tbody.querySelectorAll('.role-select').forEach(sel => sel.addEventListener('change', async (e)=>{
      const id = e.target.dataset.id; const role = e.target.value;
      const r = await fetch(`/api/users/${id}`, { method: 'PUT', headers: {'Content-Type':'application/json'}, credentials: 'include', body: JSON.stringify({ role }) });
      if (!r.ok) { alert('Mise à jour impossible'); }
      load();
    }));

    tbody.querySelectorAll('.inline-edit').forEach(inp => {
      inp.dataset.original = inp.value;
      inp.addEventListener('blur', async (e)=>{
        const id = e.target.dataset.id;
        const field = e.target.dataset.field;
        const value = (e.target.value || '').trim();
        if (value === e.target.dataset.original) return;
        if (!value) { e.target.value = e.target.dataset.original; return; }
        const payload = {}; payload[field] = value;
        const r = await fetch(`/api/users/${id}`, { method: 'PUT', headers: {'Content-Type':'application/json'}, credentials: 'include', body: JSON.stringify(payload) });
        if (!r.ok) {
          const j = await r.json().catch(()=>null);
          alert(j?.error || 'Mise à jour impossible');
          e.target.value = e.target.dataset.original;
        } else {
          e.target.dataset.original = value;
          const u = allUsers.find(x => x.id == id); if (u) u[field] = value;
        }
      });
      inp.addEventListener('keydown', (e)=>{ if (e.key === 'Enter') { e.preventDefault(); inp.blur(); } });
    });

    tbody.querySelectorAll('.verify-btn').forEach(b => b.addEventListener('click', async ()=>{
      const r = await fetch(`/api/users/${b.dataset.id}/verify-email`, { method: 'POST', credentials: 'include' });
      if (!r.ok) { alert('Verification impossible'); }
      load();
    }));

    tbody.querySelectorAll('.status-btn').forEach(b => b.addEventListener('click', async ()=>{
      const enabled = b.dataset.enabled === 'true';
      const action = enabled ? 'reactiver' : 'desactiver';
      if (!confirm(`Voulez-vous ${action} le compte "${b.dataset.label}" ?`)) return;
      const r = await fetch(`/api/users/${b.dataset.id}/status`, {
        method: 'POST',
        headers: {'Content-Type':'application/json'},
        credentials: 'include',
        body: JSON.stringify({ enabled })
      });
      if (!r.ok) {
        const j = await r.json().catch(()=>null);
        alert(j?.error || 'Changement de statut impossible');
      }
      load();
    }));

    tbody.querySelectorAll('.del-btn').forEach(b => b.addEventListener('click', async ()=>{
      if (!confirm(`Supprimer l'utilisateur "${b.dataset.label}" ?`)) return;
      const r = await fetch(`/api/users/${b.dataset.id}`, { method: 'DELETE', credentials: 'include' });
      if (!r.ok) {
        const j = await r.json().catch(()=>null);
        alert(j?.error || 'Suppression impossible');
      }
      load();
    }));

    tbody.querySelectorAll('.reset-btn').forEach(b => b.addEventListener('click', ()=>{
      const form = document.getElementById('resetPwdForm');
      form.querySelector('input[name=id]').value = b.dataset.id;
      document.getElementById('resetPwdLabel').textContent = b.dataset.label;
      form.querySelector('input[name=password]').value = '';
      document.getElementById('resetPwdMsg').textContent = '';
      new bootstrap.Modal(document.getElementById('resetPwdModal')).show();
    }));
  }

  searchInput.addEventListener('input', applyFilter);

  document.getElementById('newUserForm').addEventListener('submit', async (e)=>{
    e.preventDefault();
    const fd = new FormData(e.target);
    const payload = { name: fd.get('name'), email: fd.get('email'), role: fd.get('role'), password: fd.get('password') };
    const res = await fetch('/api/users', { method: 'POST', headers: {'Content-Type':'application/json'}, credentials: 'include', body: JSON.stringify(payload) });
    const msg = document.getElementById('newUserMsg');
    if (res.ok) {
      e.target.reset();
      bootstrap.Modal.getInstance(document.getElementById('newUserModal'))?.hide();
      load();
    } else {
      const j = await res.json().catch(()=>null);
      msg.textContent = j?.error || 'Création impossible';
    }
  });

  document.getElementById('resetPwdForm').addEventListener('submit', async (e)=>{
    e.preventDefault();
    const fd = new FormData(e.target);
    const id = fd.get('id');
    const res = await fetch(`/api/users/${id}/reset-password`, { method: 'POST', headers: {'Content-Type':'application/json'}, credentials: 'include', body: JSON.stringify({ password: fd.get('password') }) });
    const msg = document.getElementById('resetPwdMsg');
    if (res.ok) {
      bootstrap.Modal.getInstance(document.getElementById('resetPwdModal'))?.hide();
    } else {
      const j = await res.json().catch(()=>null);
      msg.textContent = j?.error || 'Réinitialisation impossible';
    }
  });

  load();
})();
</script>
