@page
@{ Layout = "_Layout"; ViewData["Title"] = "Reservations"; }

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
  <div>
    <h1 class="h4 mb-0"><i class="bi bi-clipboard-check me-2 text-warning"></i>All reservations</h1>
    <div class="text-muted small">Admin overview · filter by date or status.</div>
  </div>
  <div class="d-flex gap-2 align-items-center flex-wrap">
    <input type="date" id="from" class="form-control form-control-sm" style="width:160px" />
    <span class="text-muted">→</span>
    <input type="date" id="to" class="form-control form-control-sm" style="width:160px" />
    <select id="status" class="form-select form-select-sm" style="width:140px">
      <option value="">All status</option>
      <option value="Booked">Booked</option>
      <option value="Cancelled">Cancelled</option>
    </select>
    <button id="refresh" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-clockwise"></i></button>
  </div>
</div>

<div class="row g-2 mb-3" id="kpis">
  <div class="col-6 col-md-3"><div class="card stat-card"><div class="card-body py-2"><div class="small text-muted">Bookings shown</div><div class="fs-5 fw-bold" id="kpiTotal">0</div></div></div></div>
  <div class="col-6 col-md-3"><div class="card stat-card"><div class="card-body py-2"><div class="small text-muted">Active</div><div class="fs-5 fw-bold text-success" id="kpiActive">0</div></div></div></div>
  <div class="col-6 col-md-3"><div class="card stat-card"><div class="card-body py-2"><div class="small text-muted">Cancelled</div><div class="fs-5 fw-bold text-secondary" id="kpiCancelled">0</div></div></div></div>
  <div class="col-6 col-md-3"><div class="card stat-card"><div class="card-body py-2"><div class="small text-muted">Revenue TTC</div><div class="fs-5 fw-bold text-primary" id="kpiRevenue">0.00 €</div></div></div></div>
</div>

<div class="card">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>#</th><th>Date</th><th>Slot</th><th>Space</th><th>Customer</th><th>Status</th><th class="text-end">Total</th><th class="text-end pe-3">Invoice</th>
          </tr>
        </thead>
        <tbody id="resBody">
          <tr><td colspan="8" class="text-center text-muted py-4">Loading...</td></tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
(function(){
  const tbody = document.getElementById('resBody');
  const fmtTime = h => `${String(h).padStart(2,'0')}:00`;

  async function load(){
    const q = new URLSearchParams();
    const from = document.getElementById('from').value;
    const to = document.getElementById('to').value;
    const st = document.getElementById('status').value;
    if (from) q.set('from', from);
    if (to) q.set('to', to);
    if (st) q.set('status', st);
    const res = await fetch('/api/reservations/all?' + q.toString(), { credentials: 'include' });
    if (res.status === 401) { location.href = '/Login'; return; }
    if (res.status === 403) { tbody.innerHTML = '<tr><td colspan="8" class="text-center text-danger py-4">Admin role required.</td></tr>'; return; }
    const items = await res.json();
    let active = 0, cancelled = 0, revenue = 0;
    if (!items.length) tbody.innerHTML = '<tr><td colspan="8" class="text-center text-muted py-4">No reservations.</td></tr>';
    else {
      tbody.innerHTML = '';
      for (const r of items){
        if (r.status === 'Cancelled') cancelled++;
        else { active++; revenue += (r.totalTTC || 0); }
        const statusBadge = r.status === 'Cancelled'
          ? '<span class="badge bg-secondary">Cancelled</span>'
          : '<span class="badge bg-success">Booked</span>';
        const invoice = r.invoiceNumber
          ? `<a class="btn btn-sm btn-outline-primary" href="/api/invoices/${r.id}" target="_blank"><i class="bi bi-file-earmark-pdf me-1"></i>${r.invoiceNumber}</a>`
          : '<span class="text-muted small">—</span>';
        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td class="text-muted">#${r.id}</td>
          <td>${r.date || ''}</td>
          <td>${fmtTime(r.startHour)} → ${fmtTime(r.startHour + r.hours)} <span class="text-muted small">(${r.hours}h)</span></td>
          <td><strong>${r.spaceName || ''}</strong></td>
          <td>${r.ownerName || ''}<div class="text-muted small">${r.ownerEmail || ''}</div></td>
          <td>${statusBadge}</td>
          <td class="text-end fw-semibold">${(r.totalTTC || 0).toFixed(2)} €</td>
          <td class="text-end pe-3">${invoice}</td>`;
        tbody.appendChild(tr);
      }
    }
    document.getElementById('kpiTotal').textContent = items.length;
    document.getElementById('kpiActive').textContent = active;
    document.getElementById('kpiCancelled').textContent = cancelled;
    document.getElementById('kpiRevenue').textContent = revenue.toFixed(2) + ' €';
  }

  document.getElementById('refresh').addEventListener('click', load);
  ['from','to','status'].forEach(id => document.getElementById(id).addEventListener('change', load));
  load();
})();
</script>
