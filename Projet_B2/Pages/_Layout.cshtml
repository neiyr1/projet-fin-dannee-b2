<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>@ViewData["Title"] - Laceris Tech</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css" />
  <link href="/lib/fullcalendar/main.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="/css/map.css" />
</head>
<body>
  @{
    var currentPage = ViewData["Title"]?.ToString() ?? "";
  }

  <nav class="navbar navbar-expand-lg">
    <div class="container">
      <a class="navbar-brand d-flex align-items-center gap-2" href="/">
        <img src="/images/Logo_1_mini.svg" asp-append-version="true" alt="Logo" class="brand-logo" onerror="this.onerror=null;this.src='/images/Logo_1_mini.png?'+Date.now();" />
        <span class="fw-bold d-none d-sm-inline">Laceris Tech</span>
      </a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="mainNav">
        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
          <li class="nav-item">
            <a class="nav-link @(currentPage == "Home" ? "active" : "")" href="/">
              <i class="bi bi-house-door me-1"></i>Accueil
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link @(currentPage == "Espaces" ? "active" : "")" href="/Spaces">
              <i class="bi bi-grid me-1"></i>Espaces
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link @(currentPage == "Plan" ? "active" : "")" href="/SpacesMap">
              <i class="bi bi-map me-1"></i>Plan
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link @(currentPage == "Réservation" ? "active" : "")" href="/Booking">
              <i class="bi bi-calendar-check me-1"></i>Réserver
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link @(currentPage == "Mes réservations" ? "active" : "")" href="/MyReservations">
              <i class="bi bi-bookmark-check me-1"></i>Mes réservations
            </a>
          </li>
          <li class="nav-item dropdown" id="adminMenu" style="display:none">
            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
              <i class="bi bi-shield-lock me-1"></i><span id="adminMenuLabel">Admin</span>
            </a>
            <ul class="dropdown-menu shadow-sm">
              <li data-roles="Admin,Comptabilite"><a class="dropdown-item" href="/AdminDashboard"><i class="bi bi-speedometer2 me-2"></i>Tableau de bord</a></li>
              <li data-roles="Admin"><a class="dropdown-item" href="/AdminUsers"><i class="bi bi-people me-2"></i>Utilisateurs</a></li>
              <li data-roles="Admin,Comptabilite"><a class="dropdown-item" href="/AdminReservations"><i class="bi bi-clipboard-check me-2"></i>Réservations</a></li>
              <li data-roles="Admin"><a class="dropdown-item" href="/AdminAudit"><i class="bi bi-journal-text me-2"></i>Journal d'audit</a></li>
              <li data-roles="Admin,Accueil"><a class="dropdown-item" href="/AdminAccess"><i class="bi bi-shield-check me-2"></i>Contrôle QR</a></li>
              <li data-roles="Admin"><hr class="dropdown-divider"></li>
              <li data-roles="Admin"><a class="dropdown-item" href="/api/admin/backup"><i class="bi bi-download me-2"></i>Sauvegarde BDD</a></li>
            </ul>
          </li>
        </ul>
        <div class="d-flex align-items-center gap-2" id="userArea">
          <a id="signupLink" class="btn btn-outline-primary btn-sm" href="/Signup">
            <i class="bi bi-person-plus me-1"></i>Inscription
          </a>
          <a id="loginLink" class="btn btn-primary btn-sm" href="/Login">
            <i class="bi bi-box-arrow-in-right me-1"></i>Connexion
          </a>
          <div id="userChip" class="user-chip" style="display:none">
            <span class="user-avatar"><i class="bi bi-person-fill"></i></span>
            <div class="user-meta">
              <span id="username" class="user-name"></span>
              <span id="userRole" class="user-role"></span>
            </div>
          </div>
          <a id="logout" class="btn btn-outline-secondary btn-sm" href="#" style="display:none">
            <i class="bi bi-box-arrow-right me-1"></i>Déconnexion
          </a>
        </div>
      </div>
    </div>
  </nav>

  <div class="container my-4">
    <main>
      @RenderBody()
    </main>
    <footer class="app-footer">
      <i class="bi bi-building me-1"></i>Laceris Tech - Réservation, accès, facturation et administration de l'espace de coworking.
    </footer>
  </div>

  <!-- Toast container -->
  <div id="toastContainer" class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index:1090"></div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" defer></script>
  <script src="/lib/fullcalendar/index.global.min.js" defer></script>
  <script src="/js/app.js" defer></script>
  <script src="/js/booking.js" defer></script>
  <script src="/js/map.js" defer></script>
</body>
</html>
